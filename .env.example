# ===== 数据源模式 =====
# mock: 使用离线演示数据，无需任何外部凭证
# live: 调用真实 GitHub / 飞书 API，需填写下方凭证
DAILY_REPORT_SOURCE_MODE=mock

# 团队时区，用于把 UTC 采集结果展示为本地时间
DAILY_REPORT_TIMEZONE=Asia/Shanghai

# ===== GitHub =====
# 个人访问令牌，只勾选只读权限（public_repo 或 repo 的只读范围）
GITHUB_TOKEN=

# ===== 飞书开放平台 =====
# 自建测试应用的凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 邮件推送（SMTP）=====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# 邮箱授权码，不是登录密码
SMTP_PASSWORD=

# ===== 飞书机器人推送 =====
FEISHU_BOT_WEBHOOK=