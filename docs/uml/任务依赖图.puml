  card "T3-13\n邮件推送" as T313
  card "T3-14\n飞书机器人推送" as T314
}

package "第 3 周 · 编排与交付" {
  card "T3-15\n主编排与幂等" as T315
  card "T3-16\n命令行入口" as T316
  card "T3-17\n集成测试与分层检查" as T317
  card "T3-18\n质量收口与规范同步" as T318
