@startuml 任务依赖图
' 系统设计报告 4.4 任务依赖图（PlantUML 组件依赖图）
' 渲染：java -jar plantuml.jar docs/uml/任务依赖图.puml -tpng -charset UTF-8
title 智能日报生成器 v2 · 任务依赖

skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam card {
  BackgroundColor #F7F9FC
  BorderColor #5A6B8C
}
skinparam ArrowColor #5A6B8C

