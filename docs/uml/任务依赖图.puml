  card "T3-02\n领域模型与异常" as T302
  card "T3-03\n配置装配" as T303
  card "T3-04\n存储结构与仓储" as T304
  card "T3-05\n网络请求助手" as T305
}

package "第 3 周 · 采集层" {
  card "T3-06\n采集端口与 Mock" as T306
  card "T3-07\nGitHub 采集" as T307
  card "T3-08\n飞书任务与消息采集" as T308
}

package "第 3 周 · 生成层" {
  card "T3-09\n协作归属" as T309
  card "T3-10\n个人日报生成" as T310
  card "T3-11\n团队日报生成" as T311
}

