package "第 4 周 · 变更涟漪演练与交付" {
  card "T4-01\n变更单受理与规范同步" as T401
  card "T4-02\n任务与依赖更新" as T402
  card "T4-03\n考勤采集实现" as T403
  card "T4-04\n生成层容纳考勤条目" as T404
